# ====================================================================
# notion-2api 配置文件模板
# ====================================================================
#
# 请将此文件复制为 ".env" 并填入您的凭证。
# cp .env.example .env
#

# --- 核心安全配置 (必填) ---
API_MASTER_KEY=your_secret_key_here

# --- 部署配置 (可选) ---
NGINX_PORT=8088

# --- Notion 凭证 (以下均为必须) ---
# 1) 粘贴 token_v2 的值
NOTION_COOKIE="在此处粘贴 token_v2 值"

# 2) 您的 Space ID
NOTION_SPACE_ID="在此处粘贴您的 Space ID"

# 3) 您的用户 ID (浏览器开发者工具中 x-notion-active-user-header 的值)
NOTION_USER_ID="在此处粘贴您的 Notion 用户 ID"

# 4) 您的 Notion 用户名
NOTION_USER_NAME="你的用户名"

# 5) 您的 Notion 登录邮箱
NOTION_USER_EMAIL="你的邮箱"

# 可选：想绑定的页面 blockId。留空则不绑定特定页面上下文。
NOTION_BLOCK_ID=""

# 可选：浏览器中看到的客户端版本
NOTION_CLIENT_VERSION="23.13.20260628.0724"

# --- 临时邮箱服务配置 (用于自动注册功能) ---
# 需要部署 cloudflare_temp_email 服务（或使用兼容实现）
TEMP_EMAIL_BASE="https://temp-mail.example.com"
TEMP_EMAIL_ADMIN_AUTH="change-me"
# 收件域名：必须是你的临时邮箱服务中已配置、且未被 Notion 拒绝的域名。
TEMP_EMAIL_DOMAIN="example.com"
# 临时邮箱提供商:
#   cfmail     = cloudflare_temp_email 实例（TEMP_EMAIL_BASE / TEMP_EMAIL_ADMIN_AUTH / TEMP_EMAIL_DOMAIN）
#   emailnator = EmailNator 的 @googlemail.com 临时邮箱，可过 Notion 域名+可达性校验（推荐）
TEMP_EMAIL_PROVIDER="emailnator"

# --- 自动注册/补号出口代理 (可选，强烈建议) ---
# 注册流量（Notion 注册接口 + 临时邮箱）走代理出口，避免本机 IP 连续注册被风控。
# 支持 http/https/socks5；多个代理用逗号分隔，默认按注册尝试轮转（轮转可关）。
# 注意：同一代理 URL 的出口 IP 由代理/节点决定，注册成功与否与节点信誉强相关。
# REGISTER_PROXY=http://127.0.0.1:7890
# REGISTER_PROXY_ROTATE=1

# --- 自动补号 / 账号池维护 (可选) ---
# 默认开启：后台监控可用账号数量，低于目标时自动追加注册任务到队列。
# 目标可用账号数（默认 10；注册并发上限 3，其余在队列中等待）。
AUTO_REPLENISH_ENABLED=1
AUTO_REPLENISH_TARGET=10

# --- 研究用：抓取 Notion 官方原生工具调用（默认关闭） ---
# NOTION_CAPTURE_DIR="./capture_corpus"   # 原始 request/response/final/native.json
# NOTION_NATIVE_LOG="./native_calls.jsonl" # 解析出的 callFunction 调用

# Official Notion tool-result alignment
# thread reuse: 同一 OpenAI 会话复用同一个 Notion thread（并按创建账号绑定）
NOTION_THREAD_REUSE=1
# 把工具结果回放为官方 agent-tool-result step
NOTION_NATIVE_TOOL_REPLAY=1
# 把 assistant tool_calls 回放为官方 agent-inference/tool_use step（需 NATIVE_TOOL_REPLAY=1）
NOTION_NATIVE_TOOL_USE_REPLAY=1
# always = 兼容旧行为（另加 user 文本摘要）；native-only = 有原生回放时不加摘要；0/never = 只用官方 step
NOTION_FLATTEN_TOOL_RESULTS=1

# 测试用：把 Notion 上游指向 mock（scripts/mock_notion_upstream.py 回放官方 NDJSON）
# NOTION_API_BASE=http://127.0.0.1:8099/api/v3

# --- 流式解析 / 账号健康 / 死号清理 ---
# 结构化 NDJSON 归约器（默认开；设为 0 回退旧解析器）
NOTION_STREAM_REDUCER=1
# 账号健康巡检与死号自动清理
ACCOUNT_HEALTH_ENABLED=1
ACCOUNT_HEALTH_INTERVAL_MINUTES=30
ACCOUNT_FAILURE_THRESHOLD=3
ACCOUNT_EMPTY_THRESHOLD=2
ACCOUNT_ARCHIVE_ENABLED=1
# archive = 移入 accounts_archive.json（可恢复）；delete = 直接删除
ACCOUNT_ARCHIVE_MODE=archive
ACCOUNT_ARCHIVE_QUOTA_DAYS=7
ACCOUNT_ARCHIVE_DISABLED_DAYS=3
ACCOUNT_MAINTENANCE_INTERVAL_MINUTES=360
# 每次确认账号无额度（Notion premium 信号）后直接删除该账号；默认关闭。
# 只对明确的 quota_exceeded 生效，空响应/网络/失效等异常不会删除账号。
AUTO_DELETE_QUOTA_EXCEEDED=0
# 免费号 credits 估算上限与预留条数（预计剩余 <= 预留值时视为不可调度，提前补号）
FREE_CREDITS_LIMIT=50
QUOTA_RESERVE_REPLIES=2

# --- 注册出口节点池 / 暂停式熔断 ---
REGISTER_NODE_COOLDOWN_BASE=60
REGISTER_NODE_COOLDOWN_MAX=900
# 单节点连续失败次数达到该阈值才冻结；期间任意一次成功会清零重新计数。
REGISTER_NODE_FAILURE_THRESHOLD=3
REGISTER_NODE_STATE_FILE=register_nodes.json
REGISTER_PAUSE_AFTER_FAILURES=10
REGISTER_PAUSE_SECONDS=300
# 1 = 恢复旧行为（熔断即关闭自动补号，需手动重开）
AUTO_REPLENISH_HARD_DISABLE=0

# --- （可选）Clash 节点自动轮换，仅 REGISTER_EGRESS_MODE=clash 时启用 ---
# 注意：切换的是全局 Clash 出口，会影响其他流量；空闲后会恢复原节点。
# REGISTER_EGRESS_MODE=clash
# CLASH_API_URL=http://127.0.0.1:9090
# CLASH_PIPE=
# CLASH_SECRET=set-your-secret
# CLASH_GROUP=YOUR_PROXY_GROUP
# CLASH_NODES=英国伦敦01|CTCU|0.1x,英国伦敦02|CTCU|0.1x
# CLASH_PROXY_URL=http://127.0.0.1:7890
# CLASH_RESTORE_NODE=
# CLASH_IDLE_RESTORE_SECONDS=60
# CLASH_DRY_RUN=1
